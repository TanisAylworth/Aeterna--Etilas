function negative_data(){

// =====================================================
// NEGATIVE DATA (species tooltips)
// =====================================================
if (!variable_global_exists("negative_data"))
    global.negative_data = {};

global.negative_data[$ "Strict Code"] = {
    name: "Strict Code",
    description: "Live under tight etiquette. When interacting with other Holdstadtish, make Etiquette rolls. Success sets reaction adjustment to 0; failure sets RA to the negative of the degrees failed by."
};

global.negative_data[$ "Stiff"] = {
    name: "Stiff",
    description: "Raised under a rigid code. Must pass Willpower tests to break laws even when doing so would help you or your group."
};

global.negative_data[$ "Curious"] = {
    name: "Curious",
    description: "If something draws your attention, make a Willpower test at disadvantage to avoid fixating on it. Physical force can break the focus, but while pondering you are oblivious to danger."
};

global.negative_data[$ "Unkempt"] = {
    name: "Unkempt",
    description: "Always look shabby no matter the care taken. Reaction adjustments from Charm do not apply."
};

global.negative_data[$ "Bad Reputation"] = {
    name: "Bad Reputation",
    description: "Known for cruelty and unfriendliness from years under slavery. Reaction adjustments with nobility are reduced by 5, and with all others by 2."
};

global.negative_data[$ "Fickle"] = {
    name: "Fickle",
    description: "Long stretches of the same monotonous task cause exhaustion. After a few hours of such work, incur 1 fatigue."
};

global.negative_data[$ "Untrustworthy"] = {
    name: "Untrustworthy",
    description: "Reputation for betrayal. Non-Galish (and non-Galish-affiliated) characters suffer −4 on interactions if they know you are Galish."
};

global.negative_data[$ "Half Breed"] = {
    name: "Half Breed",
    description: "Gain all racial negatives from both parent species."
};

global.negative_data[$ "Despised"] = {
    name: "Despised",
    description: "Humans and Galish both treat Galnim as an abomination. If they know what you are, RA from either race drops to −5."
};

global.negative_data[$ "Blind"] = {
    name: "Blind",
    description: "No useful eyes. Fail all Perception checks that require sight immediately."
};

global.negative_data[$ "Slaves to Shamans"] = {
    name: "Slaves to Shamans",
    description: "Religiously dependent on C’Tal shamans as mouthpieces of the goddess. Directly disobeying an order from one requires a Willpower test at disadvantage."
};

global.negative_data[$ "Shifty"] = {
    name: "Shifty",
    description: "Seen as callous killers and thieves. Where these creatures are uncommon, civilized races start interactions at -5 RA."
};

global.negative_data[$ "Skittish"] = {
    name: "Skittish",
    description: "Fear modifiers are doubled."
};

global.negative_data[$ "Scatter Brained"] = {
    name: "Scatter Brained",
    description: "Your attention is notoriously difficult to control. Whenever concentration is important, the GM may require a Willpower test. On a success, you become intensely focused on the task at hand, treating unrelated sights and sounds as distractions and becoming effectively oblivious to them. On a failure, your attention shifts elsewhere and you cannot voluntarily resume the task until something reminds you of it."
};



global.negative_data[$ "Belligerent"] = {
    name: "Belligerent",
    description: "Your people are notorious for openly expressing their disdain toward other races. Charm provides no Reaction Adjustment bonus during social interactions, and your starting Reaction Adjustment with non allied races is always -5."
};

global.negative_data[$ "Light Sensitive"] = {
    name: "Light Sensitive",
    description: "Your eyes are adapted for life underground. When suddenly exposed to bright light, suffer a -1 penalty to all tests each round until you succeed on an Endurance test. The penalty does not continue to increase while the light persists."
};


global.negative_data[$ "Exiled"] = {
    name: "Exiled",
    description: "You have been cast out from your ancestral mountain homes. Returning under any circumstance is forbidden, and doing so carries whatever punishment your people reserve for the banished."
};

global.negative_data[$ "Wanderlust"] = {
    name: "Wanderlust",
    description: "You possess an overwhelming need to travel and explore. Remaining in the same settlement or location for longer than a day causes mounting restlessness. Beginning after the first day, gain 1 level of Fatigue for each additional day spent sedentary. This Fatigue cannot be removed until you resume meaningful travel."
};



global.negative_data[$ "Bird Bones"] = {
    name: "Bird Bones",
    description: "Your hollow bones greatly reduce your weight but fracture more easily. Damage of Type B is treated as though it were one damage die step higher before damage is resolved."
};



global.negative_data[$ "Beautiful Plumage"] = {
    name: "Beautiful Plumage",
    description: "Your vibrant feathers are highly prized for decoration, ceremonial dress, and fine fletching. In regions where your people are uncommon, others immediately take notice of your plumage, and many will attempt to purchase, barter for, or otherwise acquire your feathers."
};


global.negative_data[$ "Skittish"] = {
    name: "Skittish",
    description: "Your strong survival instincts make fear difficult to overcome. Any penalties or modifiers caused by Fear are doubled."
};

global.negative_data[$ "Filthy Pigs"] = {
    name: "Filthy Pigs",
    description: "Horrible reputation; generally hated. RA starts at −8 with all civilized races."
};

global.negative_data[$ "Ugly"] = {
    name: "Ugly",
    description: "Unpleasant to look at. During generation, Charm cannot finish above 12; if it is the last stat, it becomes 12 before racial adjustment."
};

global.negative_data[$ "Submissive"] = {
    name: "Submissive",
    description: "Used to being pushed around. If an authority figure disagrees with you, make a Willpower check at disadvantage to keep arguing."
};

global.negative_data[$ "Oiled Coat"] = {
    name: "Oiled Coat",
    description: "Fur is extremely flammable. Fire duration and damage are both doubled."
};

global.negative_data[$ "Monstrous"] = {
    name: "Monstrous",
    description: "Almost no one will deal with you willingly. Base RA −20."
};

global.negative_data[$ "Smelly"] = {
    name: "Smelly",
    description: "Fur traps odor. Scent-based Perception range is doubled when detecting this creature."
};

global.negative_data[$ "Dull"] = {
    name: "Dull",
    description: "Cannot learn to read or write without magic. May learn only 1 language besides Orcish, and may never have more than 1 rank in any knowledge-based skill."
};

global.negative_data[$ "Hated"] = {
    name: "Hated",
    description: "Treated with extreme caution. Base RA −10 with all good and neutral aligned people."
};

global.negative_data[$ "Narcissist"] = {
    name: "Narcissist",
    description: "Must be the best; hate being proven wrong. Being “beaten” forces a Will test or an act of dominant aggression against the winner. May suppress with Will, but the need must be expressed somehow (including cheating)."
};

global.negative_data[$ "Vermin"] = {
    name: "Vermin",
    description: "Rodent appearance. −5 reaction adjustment with Humans, Galish, Gnomes, and Dwarves."
};

global.negative_data[$ "Brassen Horde"] = {
    name: "Brassen Horde",
    description: "Foremost foe of the War of Horns. Detested and feared. Initial RA −10 with sentient peoples involved in that conflict."
};

global.negative_data[$ "Whimsical"] = {
    name: "Whimsical",
    description: "Driven by subtle chaos; act bizarrely at times. Civilized folk distrust this. GM may call for Willpower tests to resist sudden impulses."
};

global.negative_data[$ "Distrust"] = {
    name: "Distrust",
    description: "Other races will not easily trust the Fae. Deals are hard to make and scrutinized for wording and intent."
};

global.negative_data[$ "Manufactured"] = {
    name: "Manufactured",
    description: "Do not heal naturally. Wounds need a blacksmith or equivalent; self-maintenance never fully restores you. Treat Maintenance DoS as natural healing per camp action, but never better than a Light Wound. Serious wounds: −6 and disadvantage on that limb; critical damage makes the limb inoperable."
};

global.negative_data[$ "Rare"] = {
    name: "Rare",
    description: "Odd body shape and tail make gear hard to fit. Equipment costs 15% more in coin and labor time."
};

global.negative_data[$ "Distractible"] = {
    name: "Distractible",
    description: "Bright glints, lights, or shiny objects seize your attention. Noticing anything else first requires a Willpower test at disadvantage, then Perception."
};

global.negative_data[$ "Cat Nap"] = {
    name: "Cat Nap",
    description: "Do not clear fatigue with a single 8-hour rest. Need four 2-hour sleep periods spread through the day."
};

}